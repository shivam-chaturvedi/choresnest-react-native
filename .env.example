# Default local env used by iOS/react-native-config when no ENVFILE override is set.
# Keep this aligned with .env.development unless you intentionally need different values.

NODE_ENV=production

# Required app runtime config
SUPABASE_URL=https://rikhklhxcdhxykxxqvsc.supabase.co
SUPABASE_ANON_KEY=

# Google OAuth deep link (must match AndroidManifest / iOS URL scheme)
# Also add this exact URL in Supabase → Authentication → URL Configuration → Redirect URLs
GOOGLE_OAUTH_REDIRECT_URI=com.choresnest://auth-callback

# Feature flags
ENABLE_SYNC=true
ENABLE_IN_APP_UPDATES=true
APP_UPDATE_MODE=flexible
ENABLE_RECIPE_AND_MEALS=false
ENABLE_DEBUG_TOOLS=false
USE_PROXY_AUTH=false

# Sync tuning
EVENT_SYNC_DELAY_MS=2000
SUPABASE_SYNC_PAGE_SIZE=250
SUPABASE_SYNC_MAX_PULL_RECORDS=5000
SUPABASE_SYNC_UPSERT_BATCH=100
SUPABASE_SYNC_DELETE_BATCH=100
LOG_SYNC_NETWORK=true
LOG_SYNC_INDEX_HINTS=true

# App links / support
DELETE_ACCOUNT_FUNCTION_URL=https://rikhklhxcdhxykxxqvsc.supabase.co/functions/v1/delete-account
SUPPORT_EMAIL=support@choresnest.com

# Sentry (org: chores-nest / project: chores-nest)
# DSN is the public client key from Sentry → Project Settings → Client Keys (DSN)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Auth token is ONLY for CI/release symbol upload — never commit a real token
# Create at Sentry → Settings → Developer Settings → Auth Tokens
# Required scopes: project:releases, org:read
SENTRY_AUTH_TOKEN=
